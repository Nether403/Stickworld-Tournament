{
  "name": "stickworld-tournament",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "build": "turbo run build",
    "format": "prettier --write .",
    "determinism:node": "pnpm --filter @stickworld/sim-core determinism:node",
    "determinism:browser": "pnpm --filter @stickworld/sim-core determinism:browser",
    "replay:verify": "node packages/replay/dist/bin/replay-verify.js",
    "score:browser": "pnpm --filter @stickworld/game-test-chamber score:browser"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@stickworld/config-eslint": "workspace:*",
    "@stickworld/config-ts": "workspace:*",
    "@types/node": "22.19.21",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "turbo": "2.10.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "3.2.7"
  }
}
